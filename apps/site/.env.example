# The site process in the dev compose stack. Loaded *after* `apps/api/.env`, which
# supplies the database, cache, storage, auth secret and SITE_FORMS_SECRET; only what
# differs from the management API belongs here.
#
# Copy this to `.env` next to it, which is gitignored - `scripts/dev.sh` does that for
# you the first time you bring the stack up.
PORT=3003
PUBLIC_URL=http://localhost:3003

# The admin's origin: the only page allowed to frame the design canvas.
SITE_EDITOR_ORIGIN=http://localhost:3002

# Form submissions are forwarded to the management API here, with SITE_FORMS_SECRET.
SITE_FORMS_API_URL=http://api:3000

# Its own media cache, next to the API's.
MEDIA_CACHE_PATH=/app/docker/data/media-cache-site
