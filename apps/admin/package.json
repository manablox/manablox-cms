{
  "name": "@manablox/admin",
  "version": "0.50.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "The Manablox admin, prebuilt. @manablox/server serves it when server.admin is set.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manablox/manablox-cms.git",
    "directory": "apps/admin"
  },
  "exports": {
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/stats.html",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck:vue": "manablox-vue-check --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@manablox/admin-plugin": "workspace:*",
    "@manablox/admin-sdk": "workspace:*",
    "@manablox/core": "workspace:*",
    "@manablox/live-preview": "workspace:*",
    "@orpc/client": "catalog:",
    "@tanstack/vue-query": "catalog:",
    "@tiptap/core": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/vue-3": "catalog:",
    "@vueuse/core": "catalog:",
    "fflate": "catalog:",
    "pinia": "catalog:",
    "reka-ui": "catalog:",
    "uqr": "^0.1.3",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@manablox/config-typescript": "workspace:*",
    "@manablox/config-vitest": "workspace:*",
    "@manablox/plugin-license": "workspace:*",
    "@manablox/plugin-webhooks": "workspace:*",
    "@manablox/plugin-workflows": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "happy-dom": "catalog:",
    "rollup-plugin-visualizer": "^6.0.3",
    "tailwindcss": "catalog:",
    "typescript": "catalog:vue",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
