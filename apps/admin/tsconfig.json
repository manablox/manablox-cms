{
  "extends": "@manablox/config-typescript/base.json",
  "compilerOptions": {
    "noEmit": true,
    // An app emits nothing; the e2e fixtures import the router types of `apps/api`.
    "declaration": false,
    "declarationMap": false,
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "preserve",
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "vite.config.ts",
    "shared-modules.ts",
    "precompress.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "e2e/**/*.ts",
    "test/**/*.ts"
  ]
}
