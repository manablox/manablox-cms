# The admin SPA in the dev compose stack.
#
# Copy this to `.env` next to it, which is gitignored - `scripts/dev.sh` does that for
# you the first time you bring the stack up.
PORT=3002
# The Vite dev proxy forwards /rpc, /api, /media and /upload here, so the admin stays
# same-origin in dev exactly as it is behind nginx in production. Reached over the compose
# network, so this is the service name, not a published port.
API_URL=http://api:3000
