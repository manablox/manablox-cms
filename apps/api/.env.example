# The management API's environment inside the dev compose stack. Hostnames are compose
# service names, so this file is only correct from a container - a host `pnpm dev` reads
# the repository root's `.env` instead.
#
# `apps/public-api` and the `migrate` service load this file too: they are the same
# instance, so the database, cache and auth secret must match. They inherit the api's own
# `PORT`, `PUBLIC_URL` and `CORS_ORIGINS` with it - public-api overrides the first two and
# hardcodes `origin: '*'`, and a migration reads none of the three.
#
# Nothing here is a real secret.
#
# Copy this to `.env` next to it, which is gitignored - `scripts/dev.sh` does that for
# you the first time you bring the stack up.
NODE_ENV=development

DATABASE_URL=postgres://manablox:manablox@postgres:5432/manablox
# SQLite instead: DATABASE_URL=file:./data/manablox.db (a Turso URL also needs
# DATABASE_AUTH_TOKEN). `TEST_DATABASE_DIALECT=sqlite` runs the test suites on SQLite.
# The db and services suites create a database per test file; without this they fall back
# to `localhost`, which is not where postgres is from inside a container.
TEST_DATABASE_URL=postgres://manablox:manablox@postgres:5432/manablox
REDIS_URL=redis://valkey:6379
AUTH_SECRET=dev-secret-not-for-production

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/app/docker/data/uploads
MEDIA_CACHE_PATH=/app/docker/data/media-cache
MAIL_DRIVER=mailpit
MAILPIT_HOST=mailpit
LOG_LEVEL=debug

PORT=3000
PUBLIC_URL=http://localhost:3000
# Every browser-facing origin in the stack: the admin.
CORS_ORIGINS=http://localhost:3002

# The site process: the admin frames its design canvas there.
SITE_URL=http://localhost:3003
# Shared with the site process, which forwards form submissions with it (16 characters or
# more; forms are off while it is empty).
SITE_FORMS_SECRET=dev-forms-secret-not-for-production

# Private-network hosts a self-hosted AI provider may reach, as `host` or `host:port`.
# AI_ALLOWED_HOSTS=ollama,localhost:11434
