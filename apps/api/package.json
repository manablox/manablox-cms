{
  "name": "@manablox/api",
  "version": "0.50.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manablox/manablox-cms.git",
    "directory": "apps/api"
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsdown",
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "dev:licensed": "tsx watch src/cli/serve-licensed.ts",
    "start:licensed": "tsx src/cli/serve-licensed.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "serve:core-only": "tsx src/cli/serve-core-only.ts",
    "serve:runtime-plugins": "tsx src/cli/serve-runtime-plugins.ts",
    "typecheck": "tsc --noEmit && tsc -p scripts/tsconfig.json",
    "push:keys": "tsx src/cli/push-keys.ts",
    "seed:testing": "tsx scripts/seed/main.mts",
    "seed:perf": "tsx scripts/seed-perf.mts"
  },
  "dependencies": {
    "@manablox/api-rpc": "workspace:*",
    "@manablox/core": "workspace:*",
    "@manablox/db": "workspace:*",
    "@manablox/fields": "workspace:*",
    "@manablox/plugin-license": "workspace:*",
    "@manablox/plugin-webhooks": "workspace:*",
    "@manablox/plugin-workflows": "workspace:*",
    "@manablox/server": "workspace:*",
    "@manablox/services": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@manablox/config-typescript": "workspace:*",
    "@types/node": "catalog:",
    "sharp": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
