# The public delivery API in the dev compose stack. Loaded *after* `apps/api/.env`,
# which supplies the database, cache, storage and auth secret; only what differs from the
# management API belongs here.
#
# Copy this to `.env` next to it, which is gitignored - `scripts/dev.sh` does that for
# you the first time you bring the stack up.
PORT=3001
PUBLIC_URL=http://localhost:3001

# A public instance pins exactly one space and refuses to start without it. Set the
# machine name (or the id) once the first space exists; with exactly one space in the
# instance, both may be left blank and it is pinned automatically.
MANABLOX_SPACE=
MANABLOX_SPACE_ID=
