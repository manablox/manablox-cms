# Copy to `.env` (gitignored). Every value has a default; the two you will always set
# are the public API base URL and the frontends list.

# ---- targets -----------------------------------------------------------------------

# The public delivery instance. From inside the runner container, the host machine is
# `host.docker.internal`. On the dev compose network it would be `http://public-api:3001`.
PUBLIC_API_URL=http://host.docker.internal:3001

# Frontends to test, comma separated. Each entry is a base URL; the paths visited on each
# come from `config/targets.json` (`frontends[].paths`, matched by URL, else the default
# path list). Leave empty to test only what `targets.json` lists.
FRONTEND_URLS=

# ---- shape -------------------------------------------------------------------------

# smoke | load | stress | spike | soak | breakpoint. See scripts/lib/profiles.js for the
# exact stages.
PROFILE=load

# Scale every profile's VU count without editing it: 2 doubles, 0.5 halves.
VU_SCALE=1

# The public instance rate limits per IP (300 requests / minute by default). A load test
# from one address hits that within seconds, so either start the target with
# RATE_LIMIT=off or expect 429s; set this to true to count 429 as a failure instead of
# a skipped request.
FAIL_ON_RATE_LIMIT=false

# Locale sent as `?locale=` where the API accepts one. Empty means the space's default.
LOCALE=

# ---- controls --------------------------------------------------------------------
#
# CONTROLS=on stores a set of controls through the control API before the run (feature
# flags, soft usage limits, delivery rate rules too high to refuse; override them with
# `controls.settings` in targets.json) and puts the scope's earlier values back after it.
# The control API runs on a management process (scope `control`), not on the public API;
# on the dev network that is e.g. http://api:3102. With CONTROLS off and the URL set, the
# run only logs which scopes store values, to confirm a baseline has none.
CONTROLS=false
CONTROL_API_URL=
CONTROL_API_KEY=
CONTROLS_SCOPE=instance
# Seconds to wait after setting them; other processes pick them up within 5.
CONTROLS_SETTLE_SECONDS=6

# ---- breakpoint ------------------------------------------------------------------
#
# The capacity probe: requests per second ramped linearly from start to max over the
# ramp, no think time, aborting the moment a threshold below is crossed for longer than
# the abort delay. The summary then names the rate it broke at. If the full ramp passes,
# raise BREAKPOINT_MAX_RPS. Each VU handles one request at a time, so the VU cap must be
# at least max rate times the expected latency in seconds (5000 req/s at 100 ms = 500).

BREAKPOINT_START_RPS=50
BREAKPOINT_MAX_RPS=5000
BREAKPOINT_RAMP=10m
BREAKPOINT_MAX_VUS=1000
BREAKPOINT_ABORT_DELAY=20s

# ---- thresholds (milliseconds / ratios) --------------------------------------------
#
# Under `breakpoint` these are the break criteria, so keep them at what you would call
# acceptable rather than generous.

API_P95_MS=500
API_P99_MS=1500
FRONTEND_P95_MS=2000
FRONTEND_P99_MS=5000
MAX_ERROR_RATE=0.01

# ---- output ------------------------------------------------------------------------

# Stream metrics to the optional dashboard stack (`docker compose --profile dashboard up -d`):
# K6_OUT=influxdb=http://influxdb:8086/k6
K6_OUT=

# k6's built-in live dashboard on http://localhost:5665 while a run is going, plus an
# HTML report written to results/ when it ends.
K6_WEB_DASHBOARD=true
K6_DASHBOARD_PORT=5665
GRAFANA_PORT=3300

# Which docker network the runner joins. Leave unset for its own network with the host
# reachable as host.docker.internal.
# LOADTEST_NETWORK=manablox-cms-dev_default

# The runner writes results/ as this user; match `id -u` / `id -g` on the host.
LOADTEST_UID=1000
LOADTEST_GID=1000

K6_VERSION=0.54.0
GRAFANA_VERSION=11.2.0
