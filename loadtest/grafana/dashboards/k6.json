{
  "uid": "manablox-k6",
  "title": "manablox load test",
  "tags": ["k6"],
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "surface",
        "type": "query",
        "datasource": { "type": "influxdb", "uid": "k6-influx" },
        "query": "SHOW TAG VALUES FROM \"http_req_duration\" WITH KEY = \"surface\"",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      },
      {
        "name": "site",
        "type": "query",
        "datasource": { "type": "influxdb", "uid": "k6-influx" },
        "query": "SHOW TAG VALUES FROM \"http_req_duration\" WITH KEY = \"site\"",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Virtual users",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "influxdb", "uid": "k6-influx" },
      "targets": [
        {
          "refId": "A",
          "query": "SELECT last(\"value\") FROM \"vus\" WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests / s",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "influxdb", "uid": "k6-influx" },
      "targets": [
        {
          "refId": "A",
          "query": "SELECT sum(\"value\") / 10 FROM \"http_reqs\" WHERE $timeFilter GROUP BY time(10s) fill(0)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error rate",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "influxdb", "uid": "k6-influx" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "SELECT mean(\"value\") FROM \"http_req_failed\" WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Rate limited (429)",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "influxdb", "uid": "k6-influx" },
      "targets": [
        {
          "refId": "A",
          "query": "SELECT sum(\"value\") FROM \"rate_limited\" WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "p95 (all)",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "influxdb", "uid": "k6-influx" },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        {
          "refId": "A",
          "query": "SELECT percentile(\"value\", 95) FROM \"http_req_duration\" WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Checks passed",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "influxdb", "uid": "k6-influx" },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [
        {
          "refId": "A",
          "query": "SELECT mean(\"value\") FROM \"checks\" WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Requests / s by surface",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "influxdb", "uid": "k6-influx" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } } },
      "targets": [
        {
          "refId": "A",
          "alias": "$tag_surface",
          "query": "SELECT sum(\"value\") / 5 FROM \"http_reqs\" WHERE \"surface\" =~ /^$surface$/ AND $timeFilter GROUP BY time(5s), \"surface\" fill(0)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Virtual users",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "influxdb", "uid": "k6-influx" },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 20 } } },
      "targets": [
        {
          "refId": "A",
          "alias": "vus",
          "query": "SELECT max(\"value\") FROM \"vus\" WHERE $timeFilter GROUP BY time(5s) fill(previous)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Public API duration by request (p95)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 9 },
      "datasource": { "type": "influxdb", "uid": "k6-influx" },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        {
          "refId": "A",
          "alias": "$tag_surface $tag_name",
          "query": "SELECT percentile(\"value\", 95) FROM \"http_req_duration\" WHERE (\"surface\" = 'rest' OR \"surface\" = 'graphql') AND \"surface\" =~ /^$surface$/ AND $timeFilter GROUP BY time(10s), \"surface\", \"name\"",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Frontend page duration by site (p95)",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 9 },
      "datasource": { "type": "influxdb", "uid": "k6-influx" },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        {
          "refId": "A",
          "alias": "$tag_site",
          "query": "SELECT percentile(\"value\", 95) FROM \"http_req_duration\" WHERE \"kind\" = 'page' AND \"site\" =~ /^$site$/ AND $timeFilter GROUP BY time(10s), \"site\"",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Errors / s by surface",
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 8 },
      "datasource": { "type": "influxdb", "uid": "k6-influx" },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } } },
      "targets": [
        {
          "refId": "A",
          "alias": "$tag_surface",
          "query": "SELECT sum(\"value\") / 5 FROM \"http_req_failed\" WHERE \"surface\" =~ /^$surface$/ AND $timeFilter GROUP BY time(5s), \"surface\" fill(0)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Duration percentiles (all)",
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 8 },
      "datasource": { "type": "influxdb", "uid": "k6-influx" },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        {
          "refId": "A",
          "alias": "p50",
          "query": "SELECT percentile(\"value\", 50) FROM \"http_req_duration\" WHERE $timeFilter GROUP BY time(10s)",
          "rawQuery": true,
          "resultFormat": "time_series"
        },
        {
          "refId": "B",
          "alias": "p95",
          "query": "SELECT percentile(\"value\", 95) FROM \"http_req_duration\" WHERE $timeFilter GROUP BY time(10s)",
          "rawQuery": true,
          "resultFormat": "time_series"
        },
        {
          "refId": "C",
          "alias": "p99",
          "query": "SELECT percentile(\"value\", 99) FROM \"http_req_duration\" WHERE $timeFilter GROUP BY time(10s)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ]
    }
  ]
}
