# TLS termination and routing. Rendered into /etc/nginx/conf.d/default.conf when the
# container starts: ${ADMIN_DOMAIN}, ${PUBLIC_DOMAIN} and ${UPLOAD_BODY_LIMIT} come from
# .env, every other $variable is nginx's own. Whether a domain is served over TLS was
# decided when the project was generated; certificates are read from nginx/certs/
# (fullchain.pem and privkey.pem, covering every TLS domain). scripts/selfsigned-certs.sh
# writes a pair for a trial; use certbot or your CA for the real ones.

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# The admin and the management API, one origin.
__ADMIN_SITE__
{{#if publicApi}}

# The public delivery API. Anonymous, cacheable: a CDN can sit in front of this host and
# honour the s-maxage the API sends.
__PUBLIC_SITE__
{{/if}}

{{slot nginx.sites}}
