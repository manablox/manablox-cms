{{#if example}}
# Copy to `.env` and fill in the secrets.
{{/if}}
{{#if docker}}
# docker compose reads `.env` for the substitutions in compose.yml and hands all of it to
{{#if publicApi}}
# the api and migrate containers. The public container gets only the variables
# compose.yml lists for it.
{{#else}}
# the api and migrate containers.
{{/if}}
{{#else}}
{{#if sqlite}}
# `.env` is read twice: by docker compose for the cache service, and by the `manablox`
# CLI before it evaluates the config files. A variable already set in the shell wins
# over the file.
{{#else}}
# `.env` is read twice: by docker compose for the database and cache services, and by the
# `manablox` CLI before it evaluates the config files. A variable already set in the
# shell wins over the file.
{{/if}}
{{/if}}
{{#if caddy}}

# --- Domains -----------------------------------------------------------------------------
# Caddy obtains TLS certificates for these automatically (Let's Encrypt). Both must point
# at this host. For a plain-http trial on your own machine use
#   ADMIN_DOMAIN=http://cms.localhost  PUBLIC_DOMAIN=http://content.localhost
ADMIN_DOMAIN=__ADMIN_DOMAIN__
{{#if publicApi}}
PUBLIC_DOMAIN=__PUBLIC_DOMAIN__
{{/if}}
# Where Let's Encrypt sends certificate expiry notices.
ACME_EMAIL=__ACME_EMAIL__

# The origins the processes are reached at. They must match the domains above,
# including the scheme.
PUBLIC_URL=__ADMIN_URL__
{{#if publicApi}}
PUBLIC_API_URL=__PUBLIC_API_URL__
{{/if}}
{{/if}}
{{#if nginx}}

# --- Domains -----------------------------------------------------------------------------
# The host names nginx routes by. Both must point at this host. Whether a domain is
# served with TLS was decided when the project was generated and lives in
# nginx/templates/default.conf.template; the certificate files go into nginx/certs/.
ADMIN_DOMAIN=__ADMIN_HOST__
{{#if publicApi}}
PUBLIC_DOMAIN=__PUBLIC_HOST__
{{/if}}

# The origins the processes are reached at. They must match the domains above,
# including the scheme.
PUBLIC_URL=__ADMIN_URL__
{{#if publicApi}}
PUBLIC_API_URL=__PUBLIC_API_URL__
{{/if}}
{{/if}}
{{#if ports}}

# --- Ports and origins -------------------------------------------------------------------
# The host ports compose publishes, and the origins your proxy serves the processes at.
# Terminate TLS in the proxy, forward X-Forwarded-Proto and X-Forwarded-Host, and set
# the origins to what a browser sees.
ADMIN_PORT=__ADMIN_PORT__
PUBLIC_URL=__ADMIN_URL__
{{#if publicApi}}
PUBLIC_PORT=__PUBLIC_PORT__
PUBLIC_API_URL=__PUBLIC_API_URL__
{{/if}}
{{/if}}
{{#if local}}
{{#if sqlite}}

# --- Services ----------------------------------------------------------------------------
# Where docker compose publishes Valkey, and how the CMS reaches it and its database.
# The SQLite file is relative to this folder and created by `pnpm migrate`.
VALKEY_PORT=__VALKEY_PORT__
DATABASE_URL=file:./data/manablox.db
REDIS_URL=redis://localhost:__VALKEY_PORT__
{{#else}}

# --- Services ----------------------------------------------------------------------------
# Where docker compose publishes Postgres and Valkey, and how the CMS reaches them.
POSTGRES_PORT=__POSTGRES_PORT__
VALKEY_PORT=__VALKEY_PORT__
# The CMS connects as the app role; `pnpm migrate` migrates as the owner role and grants
# the app role its rights.
DATABASE_URL=postgres://manablox_app:__DATABASE_APP_PASSWORD__@localhost:__POSTGRES_PORT__/manablox
MIGRATION_DATABASE_URL=postgres://manablox_owner:__DATABASE_OWNER_PASSWORD__@localhost:__POSTGRES_PORT__/manablox
{{#if readOnlyRole}}
# The read-only role the processes that only read connect as; created on the first start.
PUBLIC_DATABASE_URL=postgres://manablox_public:__POSTGRES_PUBLIC_PASSWORD__@localhost:__POSTGRES_PORT__/manablox
{{/if}}
REDIS_URL=redis://localhost:__VALKEY_PORT__
{{/if}}

# --- Ports and origins -------------------------------------------------------------------
PORT=__ADMIN_PORT__
PUBLIC_URL=__ADMIN_URL__
{{#if publicApi}}
PUBLIC_PORT=__PUBLIC_PORT__
PUBLIC_API_URL=__PUBLIC_API_URL__
{{/if}}
{{/if}}

# --- Secrets -----------------------------------------------------------------------------
{{#if sqlite}}
# `openssl rand -hex 32` for each.
{{#else}}
# `openssl rand -hex 32` for each: URL-safe, so a password fits into a connection string.
{{/if}}
{{#if !sqlite}}
{{#if local}}
# The same passwords as in the connection strings above; compose creates the roles with
# them. POSTGRES_PASSWORD is the superuser's, for administration only.
{{#else}}
# The database roles compose creates on the first start: the owner runs the migrations,
# the app role is what the CMS logs in as. POSTGRES_PASSWORD is the superuser's, for
# administration only.
DATABASE_OWNER_USER=manablox_owner
DATABASE_APP_USER=manablox_app
{{/if}}
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
DATABASE_OWNER_PASSWORD=__DATABASE_OWNER_PASSWORD__
DATABASE_APP_PASSWORD=__DATABASE_APP_PASSWORD__
{{#if readOnlyRole}}
POSTGRES_PUBLIC_PASSWORD=__POSTGRES_PUBLIC_PASSWORD__
{{/if}}
{{/if}}
# AUTH_SECRET signs sessions and media URLs and encrypts the stored credentials
# and AI provider keys. Rotating it signs everyone out, invalidates every image URL a CDN
# holds and leaves those stored secrets unreadable until they are entered again.
AUTH_SECRET=__AUTH_SECRET__
# Optional: a separate secret for media transform URLs so the two rotate independently.
MEDIA_SIGNING_SECRET=
{{#if publicApi}}

# --- Public delivery API -----------------------------------------------------------------
# The one space the public instance serves, by technical name. With exactly one space in
# the database it may stay empty; with several the instance refuses to start without it.
MANABLOX_SPACE=
# Seconds a delivery response is cached, and its s-maxage.
PUBLIC_CACHE_TTL=300
# GraphQL introspection is off on the public instance unless this is `true`.
PUBLIC_GRAPHQL_INTROSPECTION=false
{{/if}}

{{slot env}}

# --- Browser clients of the management API -----------------------------------------------
# The admin is same-origin and needs no entry. Comma-separated origins of your own
# frontends that call /rpc or the management /graphql from a browser (preview, live
# editing). Leave empty if there are none.
CORS_ORIGINS=

# --- Storage -----------------------------------------------------------------------------
{{#if docker}}
# `local` writes to the `uploads` volume. `s3` needs the S3_* variables.
{{#else}}
# `local` writes to STORAGE_LOCAL_PATH. `s3` needs the S3_* variables.
{{/if}}
STORAGE_DRIVER=__STORAGE__
{{#if local}}
STORAGE_LOCAL_PATH=./data/uploads
MEDIA_CACHE_PATH=./data/media-cache
{{#if publicApi}}
PUBLIC_MEDIA_CACHE_PATH=./data/media-cache-public
{{/if}}
{{/if}}
# Optional: a public origin that serves the local uploads directly, bypassing the API.
# STORAGE_LOCAL_PUBLIC_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=
S3_PUBLIC_URL=
FILE_MAX_SIZE_MB=25
{{#if caddy}}
# The proxy's request body limit; keep it above FILE_MAX_SIZE_MB.
UPLOAD_BODY_LIMIT=32MB
{{/if}}
{{#if nginx}}
# The proxy's request body limit (nginx syntax); keep it above FILE_MAX_SIZE_MB.
UPLOAD_BODY_LIMIT=32m
{{/if}}

# --- Mail --------------------------------------------------------------------------------
# How mail leaves: smtp, mailpit, gmail, microsoft, resend, sendgrid, postmark, mailgun
# or none. Another driver reads other variables; the README lists them.
MAIL_DRIVER=__MAIL_DRIVER__
{{#if mailConfigured}}
{{#if mailbox}}
# Empty sends as the mailbox itself.
MAIL_FROM=
{{#else}}
MAIL_FROM=Manablox <no-reply@__MAIL_HOST__>
{{/if}}
__MAIL_DRIVER_ENV__
{{/if}}

# --- Outgoing network --------------------------------------------------------------------
# `true` lets outgoing calls (workflow HTTP steps, webhooks, self-hosted AI) reach private
# and loopback addresses. Only on an isolated install you trust.
NET_ALLOW_PRIVATE_NETWORK=false

# --- Push notifications ------------------------------------------------------------------
{{#if docker}}
# `docker compose run --rm --no-deps api push-keys` prints a pair. Never change them once
{{#else}}
# `pnpm push-keys` prints a pair. Never change them once
{{/if}}
# browsers have subscribed.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:{{#if caddy}}__ACME_EMAIL__{{#else}}admin@__MAIL_HOST__{{/if}}

# --- Tuning ------------------------------------------------------------------------------
LOG_LEVEL=info
DB_POOL_MAX=10
# Also read when set: LOG_PRETTY, LOG_FILE, LOG_HTTP_URL and the other LOG_* variables,
# ALLOWED_MIME_TYPES, {{#if sqlite}}DATABASE_AUTH_TOKEN{{#else}}DATABASE_SSL{{/if}}, CACHE_ENABLED, CACHE_TTL, CACHE_SYNC_INTERVAL, GRAPHQL_MAX_DEPTH{{#if publicApi}},
# RATE_LIMIT=off (public instance){{/if}}.
