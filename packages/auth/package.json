{
  "name": "@manablox/auth",
  "version": "0.50.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manablox/manablox-cms.git",
    "directory": "packages/auth"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@manablox/core": "workspace:*",
    "@manablox/db": "workspace:*",
    "@better-auth/core": "catalog:",
    "@better-auth/sso": "catalog:",
    "@better-auth/utils": "catalog:",
    "@better-fetch/fetch": "catalog:",
    "better-auth": "catalog:",
    "better-call": "catalog:",
    "jose": "catalog:",
    "kysely": "catalog:",
    "nanostores": "catalog:",
    "drizzle-orm": "catalog:",
    "@node-rs/argon2": "catalog:"
  },
  "devDependencies": {
    "@manablox/config-typescript": "workspace:*",
    "@manablox/config-vitest": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  }
}
