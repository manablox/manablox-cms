{
  "name": "@manablox/live-preview",
  "version": "0.50.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manablox/manablox-cms.git",
    "directory": "packages/live-preview"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./rich-text": {
      "types": "./src/rich-text.ts",
      "default": "./src/rich-text.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@manablox/public-sdk": "workspace:*",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-text-align": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/starter-kit": "catalog:"
  },
  "devDependencies": {
    "@manablox/config-typescript": "workspace:*",
    "@manablox/config-vitest": "workspace:*",
    "@types/node": "catalog:",
    "happy-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./rich-text": {
        "types": "./dist/rich-text.d.ts",
        "default": "./dist/rich-text.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  }
}
