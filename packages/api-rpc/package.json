{
  "name": "@manablox/api-rpc",
  "version": "0.50.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manablox/manablox-cms.git",
    "directory": "packages/api-rpc"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./plugin": {
      "types": "./src/plugin.ts",
      "default": "./src/plugin.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@manablox/auth": "workspace:*",
    "@manablox/core": "workspace:*",
    "@manablox/db": "workspace:*",
    "@manablox/media": "workspace:*",
    "@manablox/services": "workspace:*",
    "@orpc/contract": "catalog:",
    "@orpc/server": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@manablox/config-typescript": "workspace:*",
    "@manablox/config-vitest": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./plugin": {
        "types": "./dist/plugin.d.ts",
        "default": "./dist/plugin.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  }
}
