{
  "name": "@manablox/config-vitest",
  "version": "0.52.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/dom-clock.ts",
    "./dist/dom-clock.js"
  ],
  "engines": {
    "node": ">=24"
  },
  "description": "The shared vitest settings of the Manablox packages and plugin repositories.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manablox/manablox-cms.git",
    "directory": "packages/config-vitest"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./dom-clock": {
      "types": "./src/dom-clock.ts",
      "default": "./src/dom-clock.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "happy-dom": ">=20",
    "vitest": ">=5"
  },
  "peerDependenciesMeta": {
    "happy-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@manablox/config-typescript": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./dom-clock": {
        "types": "./dist/dom-clock.d.ts",
        "default": "./dist/dom-clock.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  }
}
