{
  "extends": "@manablox/config-typescript/base.json",
  "compilerOptions": {
    "noEmit": true,
    // A check only: the admin bundle's types are never emitted, and naming the router's
    // types would need every package they come from as a direct dependency.
    "declaration": false,
    "declarationMap": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "preserve",
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/admin/**/*.ts",
    "src/admin/**/*.vue",
    "test/admin/**/*.ts",
    "vite.admin.config.ts",
    "vitest.admin.config.ts"
  ]
}
