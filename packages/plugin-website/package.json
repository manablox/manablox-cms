{
  "name": "@manablox/plugin-website",
  "version": "0.52.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "Designed websites for Manablox: the visual designer, themes, the website server mode, forms and domains.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manablox/manablox-cms.git",
    "directory": "packages/plugin-website"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./site": {
      "types": "./src/site/index.ts",
      "default": "./src/site/index.ts"
    },
    "./sdk": {
      "types": "./src/sdk.ts",
      "default": "./src/sdk.ts"
    },
    "./cli": {
      "types": "./src/cli/index.ts",
      "default": "./src/cli/index.ts"
    },
    "./admin-src": {
      "types": "./src/admin/index.ts",
      "default": "./src/admin/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "manablox": {
    "plugin": "website",
    "cli": "@manablox/plugin-website/cli"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "migrations",
    "migrations-sqlite",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && pnpm build:admin",
    "build:admin": "vite build --config vite.admin.config.ts",
    "generate": "drizzle-kit generate && drizzle-kit generate --config drizzle.sqlite.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:vue": "manablox-vue-check --noEmit -p tsconfig.admin.json",
    "test": "vitest run && vitest run --config vitest.admin.config.ts"
  },
  "dependencies": {
    "@manablox/api-graphql": "workspace:*",
    "@manablox/api-public": "workspace:*",
    "@manablox/api-rpc": "workspace:*",
    "@manablox/auth": "workspace:*",
    "@manablox/cache": "workspace:*",
    "@manablox/core": "workspace:*",
    "@manablox/db": "workspace:*",
    "@manablox/media": "workspace:*",
    "@manablox/server": "workspace:*",
    "@manablox/services": "workspace:*",
    "@manablox/site": "workspace:*",
    "@manablox/site-renderer": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@manablox/admin-plugin": "workspace:*",
    "@manablox/admin-sdk": "workspace:*",
    "@manablox/config-typescript": "workspace:*",
    "@manablox/config-vitest": "workspace:*",
    "@manablox/fields": "workspace:*",
    "@manablox/live-preview": "workspace:*",
    "@manablox/public-sdk": "workspace:*",
    "@orpc/server": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/vue-query": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vueuse/core": "catalog:",
    "drizzle-kit": "catalog:",
    "happy-dom": "catalog:",
    "pinia": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:vue",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./site": {
        "types": "./dist/site.d.ts",
        "default": "./dist/site.js"
      },
      "./sdk": {
        "types": "./dist/sdk.d.ts",
        "default": "./dist/sdk.js"
      },
      "./cli": {
        "types": "./dist/cli.d.ts",
        "default": "./dist/cli.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  }
}
