{
  "name": "@manablox/site-renderer",
  "version": "0.50.1",
  "license": "MIT",
  "description": "Renders a designed Manablox site to HTML, with its island scripts, the design canvas and bundled fonts.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manablox/manablox-cms.git",
    "directory": "packages/site-renderer"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./assets": {
      "types": "./src/assets.ts",
      "default": "./src/assets.ts"
    },
    "./canvas": {
      "types": "./src/canvas/index.ts",
      "default": "./src/canvas/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsdown && tsx scripts/build-client.ts",
    "fonts": "node scripts/fetch-fonts.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@manablox/core": "workspace:*",
    "@manablox/live-preview": "workspace:*",
    "@manablox/public-sdk": "workspace:*",
    "@manablox/site": "workspace:*",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@manablox/config-typescript": "workspace:*",
    "@manablox/config-vitest": "workspace:*",
    "@types/node": "catalog:",
    "happy-dom": "catalog:",
    "rolldown": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "fonts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./assets": {
        "types": "./dist/assets.d.ts",
        "default": "./dist/assets.js"
      },
      "./canvas": {
        "types": "./dist/canvas.d.ts",
        "default": "./dist/canvas.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  }
}
